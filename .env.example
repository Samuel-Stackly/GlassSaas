# ─── Server (server/.env) ────────────────────────────────────────────
# Local dummy values only. Replace before connecting to real data.
MONGO_URI=mongodb://127.0.0.1:27017/glasssaas
JWT_SECRET=local-dummy-secret-replace-before-use
JWT_EXPIRES_IN=7d
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Optional, development only — see server/.env.example and README > Troubleshooting
MONGO_SRV_DNS_WORKAROUND=false

# ─── Client (client/.env) ────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
